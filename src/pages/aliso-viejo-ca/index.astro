---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { pages, services } from '../../lib/content';
import { SITE } from '../../data/site';
import { breadcrumb } from '../../lib/schema';

const page = pages['/aliso-viejo-ca/'];
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Aliso Viejo, CA', path: '/aliso-viejo-ca/' }];
const place = {
  '@type': 'City',
  name: 'Aliso Viejo',
  containedInPlace: { '@type': 'AdministrativeArea', name: 'Orange County, California' },
  sameAs: 'https://en.wikipedia.org/wiki/Aliso_Viejo,_California',
};
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent('Aliso Viejo, CA')}&output=embed`;
---
<BaseLayout title={page.title} description={page.description} schema={[place, breadcrumb(crumbs)]}>
  <PageHero title={page.h1} eyebrow="Aliso Viejo California" crumbs={crumbs} lede="Up to date local events, news, weather and other important information for the city of Aliso Viejo California." />

  <section class="section">
    <div class="container local">
      <div class="reveal">
        <h2>Your neighborhood concierge physician</h2>
        <p>{SITE.about}</p>
        <ul class="links">
          <li><a href="https://en.wikipedia.org/wiki/Aliso_Viejo,_California" target="_blank" rel="noopener">About Aliso Viejo, CA <Icon name="arrow" size={14} /></a></li>
          <li><a href="https://avcity.org/" target="_blank" rel="noopener">City of Aliso Viejo — Local Events &amp; News <Icon name="arrow" size={14} /></a></li>
          <li><a href="https://forecast.weather.gov/MapClick.php?lat=33.5732&lon=-117.7037" target="_blank" rel="noopener">Aliso Viejo Weather Forecast <Icon name="arrow" size={14} /></a></li>
        </ul>
        <div class="office">
          <strong>{SITE.name}</strong>
          <span>{SITE.address.street}, {SITE.address.city}, {SITE.address.region} {SITE.address.postal}</span>
          <div class="office__btns">
            <a href={SITE.directionsUrl} target="_blank" rel="noopener" class="btn btn--ghost btn--sm">Get Directions</a>
            <a href={SITE.phoneHref} class="btn btn--gold btn--sm"><Icon name="phone" /> Book Today! {SITE.phone}</a>
          </div>
        </div>
      </div>
      <iframe class="reveal" title="Map of Aliso Viejo, California" src={mapSrc} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <h2 class="center">Care available in Aliso Viejo</h2>
      <ul class="svc">{services.map((s) => <li><a href={s.path}>{s.name}</a></li>)}</ul>
    </div>
  </section>
</BaseLayout>
<style>
  .local { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (max-width: 900px) { .local { grid-template-columns: 1fr; } }
  .local iframe { width: 100%; height: 420px; border: 0; border-radius: var(--radius-lg); box-shadow: var(--shadow); }
  .links { list-style: none; padding: 0; margin: 1.5rem 0; display: grid; gap: .5rem; }
  .links a { display: inline-flex; gap: .4rem; align-items: center; font-weight: 700; text-decoration: none; }
  .office { padding: 1.5rem; border-radius: var(--radius-lg); background: #fff; border: 1px solid var(--line); display: grid; gap: .3rem; }
  .office strong { font-family: var(--font-display); font-size: 1.4rem; color: var(--ink); }
  .office span { color: var(--muted); }
  .office__btns { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .75rem; }
  .svc { list-style: none; padding: 0; margin: 2rem 0 0; display: flex; flex-wrap: wrap; gap: .5rem; justify-content: center; }
  .svc a { display: inline-block; padding: .5rem 1rem; border-radius: 999px; background: #fff; border: 1px solid var(--line); text-decoration: none; font-size: .9rem; color: var(--ink); }
  .svc a:hover { border-color: var(--gold); color: var(--gold); }
</style>
