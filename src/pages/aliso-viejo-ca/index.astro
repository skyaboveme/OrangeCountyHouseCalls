---
import CityHouseCallLanding from '../../components/CityHouseCallLanding.astro';
import { CITY_BY_SLUG } from '../../data/cities';
import { services } from '../../lib/content';

const city = CITY_BY_SLUG['aliso-viejo-ca'];
---

<CityHouseCallLanding city={city}>
  <section class="section section--sand" aria-labelledby="av-svc-title">
    <div class="container">
      <div class="center reveal">
        <p class="eyebrow">Full Clinical Directory</p>
        <h2 id="av-svc-title">All Medical Services Available in Aliso Viejo</h2>
        <p class="lede">
          Explore our complete internal medicine, urgent illness, injury, and wellness services available via house call, telemedicine, or at our Mareblu clinic in Aliso Viejo.
        </p>
      </div>
      <ul class="svc reveal">
        {services.map((s) => (
          <li><a href={s.path}>{s.name}</a></li>
        ))}
      </ul>
    </div>
  </section>
</CityHouseCallLanding>

<style>
  .svc {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
  .svc a {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--ink);
  }
  .svc a:hover {
    border-color: var(--gold);
    color: var(--gold);
  }
</style>
