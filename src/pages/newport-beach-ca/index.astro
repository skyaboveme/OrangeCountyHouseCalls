---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import FAQList from '../../components/FAQList.astro';
import { Image } from 'astro:assets';
import hero from '../../assets/s1-new-2.jpg';
import consult from '../../assets/s1.jpg';
import doc from '../../assets/dr-khaneki-2607.jpg';
import { SITE, DOCTOR, MEMBERSHIP } from '../../data/site';
import { REVIEWS } from '../../data/reviews';
import { breadcrumb, faqPage, medicalWebPage, serviceSchema } from '../../lib/schema';

const path = '/newport-beach-ca/';
const title = `House Call Doctor in Newport Beach, CA | Same-Day In-Home Physician | ${SITE.phone}`;
const description = `Need a house call doctor in Newport Beach, CA? Board-certified Internal Medicine physician Dr. Sina Khaneki, MD, MPH brings private, unrushed medical care directly to your Newport Beach home, hotel, or office — 7 days a week. Call ${SITE.phone}.`;

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Newport Beach House Calls', path },
];

const action = SITE.formEmail ? `https://formsubmit.co/${SITE.formEmail}` : '';

const neighborhoods = [
  'Corona del Mar',
  'Newport Coast',
  'Balboa Island',
  'Balboa Peninsula',
  'Lido Isle',
  'Pelican Hill',
  'Harbor Ridge',
  'Dover Shores',
  'Eastbluff',
  'Newport Heights',
  'Fashion Island Area',
  'Crystal Cove',
];

const credentials = [
  { icon: 'shield', big: 'Board-Certified', small: 'Internal Medicine (MD, MPH)' },
  { icon: 'clock', big: 'Same-Day / Next-Day', small: 'Open 7 Days · 6 AM – 8 PM' },
  { icon: 'home', big: 'At Your Doorstep', small: 'Home, Hotel, Office or Senior Living' },
  { icon: 'star', big: '5.0 ★ Rated', small: 'Trusted Across Coastal Orange County' },
];

const careCategories = [
  {
    icon: 'activity',
    title: 'Urgent & Sick House Calls',
    text: 'Skip the crowded Newport Beach urgent care waiting room. Get thorough in-home evaluation and rapid relief when you or a loved one feel unwell.',
    items: [
      { label: 'Cold, Flu & Respiratory Illness', href: '/aliso-viejo-ca/common-cold-and-flu-treatment/' },
      { label: 'Sinus, Ear & Strep Throat Infections', href: '/aliso-viejo-ca/sinus-infection-treatment/' },
      { label: 'Fever, Dehydration & Food Poisoning', href: '/aliso-viejo-ca/food-poisoning-treatment/' },
      { label: 'UTI, Migraines & Acute Pain', href: '/aliso-viejo-ca/urinary-tract-infection/' },
    ],
  },
  {
    icon: 'heart',
    title: 'Senior & Geriatric House Calls',
    text: 'Compassionate, unhurried medical visits for older adults at home or in Newport Beach senior living communities — giving families complete peace of mind.',
    items: [
      { label: 'Comprehensive Geriatric Care', href: '/aliso-viejo-ca/geriatric-medicine/' },
      { label: 'Post-Hospital & Fall Evaluations', href: '/aliso-viejo-ca/when-an-older-person-falls/' },
      { label: 'Chronic Disease & Medication Review', href: '/aliso-viejo-ca/chronic-disease-management/' },
      { label: 'Mobility-Friendly In-Home Exams', href: '/aliso-viejo-ca/physical-exams/' },
    ],
  },
  {
    icon: 'stethoscope',
    title: 'Concierge Primary Care & Wellness',
    text: 'Ongoing private physician access, executive-level preventive care, and medically supervised weight loss tailored to your lifestyle.',
    items: [
      { label: 'Premier Concierge Medicine', href: '/aliso-viejo-ca/concierge-medicine/' },
      { label: 'Physician-Guided Weight Loss', href: '/aliso-viejo-ca/weight-loss-treatment/' },
      { label: 'Preventive & Longevity Care', href: '/aliso-viejo-ca/preventive-medicine/' },
      { label: 'Minor Injuries & Auto Accidents', href: '/aliso-viejo-ca/personal-injury-auto-accident-care/' },
    ],
  },
];

const steps = [
  {
    n: '01',
    title: 'Call or Request Online',
    text: `Call us directly at ${SITE.phone} or submit the quick form on this page. We confirm your symptoms, Newport Beach location, and preferred arrival window.`,
  },
  {
    n: '02',
    title: 'Dr. Khaneki Arrives at Your Door',
    text: 'A board-certified Internal Medicine physician — never a rotating gig-economy provider — arrives at your home, coastal residence, hotel, or office.',
  },
  {
    n: '03',
    title: 'Unrushed Exam, Treatment & Follow-Up',
    text: 'Receive a thorough evaluation, personalized treatment plan, prescriptions sent straight to your preferred Newport Beach pharmacy, and direct follow-up access.',
  },
];

const compare = [
  ['Driving down PCH or MacArthur while sick', 'Stay resting in your own Newport Beach bed'],
  ['60–90+ minute urgent care wait times', 'Same-day or next-day scheduled arrival'],
  ['7-minute rushed visit with a mid-level provider', 'Extended, unhurried visit with an MD, MPH Internist'],
  ['Exposure to contagious waiting rooms', '100% private, discreet care at your residence'],
  ['Hard to reach anyone for follow-up questions', 'Direct phone access to Dr. Khaneki'],
];

const reviews = REVIEWS.filter((r) => r.source === 'Google').slice(0, 3);
const featuredStory = REVIEWS.find((r) => r.name === 'Omid H');

const nbFaqs = [
  {
    q: 'How quickly can a house call doctor arrive in Newport Beach?',
    a: `We offer same-day and next-day house call appointments throughout Newport Beach 7 days a week from ${SITE.hours.label}. For the fastest dispatch, call us directly at <a href="${SITE.phoneHref}">${SITE.phone}</a>.`,
  },
  {
    q: 'Do I need a monthly membership to book a single house call in Newport Beach?',
    a: 'No. You can book a one-time Newport Beach house call for a flat <strong>$500/visit</strong> with no membership required. If you want ongoing direct physician access, house calls, telemedicine, and in-office care year-round, our Premier Concierge Membership is $500/month (with a 1-year membership).',
  },
  {
    q: 'Which Newport Beach neighborhoods, hotels, and communities do you serve?',
    a: 'Dr. Khaneki travels to homes, estates, offices, yachts/marinas, senior living communities, and resorts across all of Newport Beach — including Corona del Mar, Newport Coast, Pelican Hill, Balboa Island, Balboa Peninsula, Lido Isle, Dover Shores, Harbor Ridge, Eastbluff, Newport Heights, and Crystal Cove.',
  },
  {
    q: 'Will I see an actual board-certified MD during my house call?',
    a: 'Yes. Every house call is personally performed by <strong>Dr. Sina Khaneki, MD, MPH</strong>, a board-certified Internal Medicine physician and former Ambulatory Clinic Chief Resident — never an outsourced urgent care contractor.',
  },
  {
    q: 'Can Dr. Khaneki send prescriptions to my Newport Beach pharmacy?',
    a: 'Yes. If medication is medically appropriate, Dr. Khaneki electronically sends prescriptions immediately to your preferred Newport Beach pharmacy (including Via Lido Drugs, Corona del Mar pharmacies, CVS, Walgreens, or delivery pharmacies).',
  },
  {
    q: 'Do you take insurance for Newport Beach house calls?',
    a: 'Our house call fee ($500/visit) and concierge membership are direct-pay and not billed to insurance, allowing us to provide extended, unhurried visits without insurance restrictions. However, you may still use your insurance for outside lab work, imaging, prescriptions, and specialist referrals.',
  },
];

const placeSchema = {
  '@type': 'Service',
  name: 'House Call Doctor & Concierge Medicine in Newport Beach, CA',
  serviceType: 'In-Home Medical Care / Physician House Calls',
  provider: { '@id': `${SITE.url}/#clinic` },
  areaServed: {
    '@type': 'City',
    name: 'Newport Beach, CA',
    sameAs: 'https://en.wikipedia.org/wiki/Newport_Beach,_California',
  },
  description,
  offers: {
    '@type': 'Offer',
    price: '500',
    priceCurrency: 'USD',
    description: 'Single Newport Beach physician house call ($500/visit) or Premier Concierge Membership ($500/month).',
  },
};

const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent('Newport Beach, CA')}&output=embed`;
---

<BaseLayout
  title={title}
  description={description}
  schema={[
    medicalWebPage({ path, title, description, about: 'House Call Doctor in Newport Beach, CA' }),
    serviceSchema({ name: 'House Call Doctor in Newport Beach', path, description }),
    placeSchema,
    breadcrumb(crumbs),
    faqPage(nbFaqs),
  ]}
>
  <!-- HIGH-CONVERTING PAID TRAFFIC HERO -->
  <section class="nb-hero" aria-labelledby="nb-hero-title">
    <Image
      src={hero}
      alt="Dr. Sina Khaneki, MD, MPH — Newport Beach House Call Physician"
      class="nb-hero__bg"
      widths={[640, 1024, 1440, 1835]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="nb-hero__overlay"></div>

    <div class="container nb-hero__grid">
      <div class="nb-hero__copy">
        <div class="nb-pill">
          <span class="nb-pill__dot" aria-hidden="true"></span>
          <span>Serving All Newport Beach Neighborhoods · 7 Days a Week</span>
        </div>

        <h1 id="nb-hero-title">
          Private <span class="gold-text">House Call Doctor</span> in Newport Beach, CA
        </h1>

        <p class="nb-hero__lede">
          Skip the crowded urgent care waiting room. Board-certified Internal Medicine physician <strong>Dr. Sina Khaneki, MD, MPH</strong> comes directly to your Newport Beach home, hotel, or office for same-day and next-day medical care.
        </p>

        <div class="nb-hero__ctas">
          <a href={SITE.phoneHref} class="btn btn--gold btn--lg">
            <Icon name="phone" /> Call Now: {SITE.phone}
          </a>
          <button type="button" class="btn btn--light btn--lg" data-open-appt>
            <Icon name="calendar" /> Book Online
          </button>
        </div>

        <ul class="nb-hero__trust">
          <li><Icon name="check" size={16} /> <strong>$500</strong> flat-rate single house call (no membership required)</li>
          <li><Icon name="check" size={16} /> Speak directly with a board-certified MD — never a call center</li>
          <li><Icon name="check" size={16} /> Prescriptions sent immediately to your local Newport Beach pharmacy</li>
        </ul>

        <div class="nb-hero__proof">
          <span class="nb-stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={16} />)}</span>
          <span><strong>5.0 Rating on Google</strong> · Discreet, unrushed care at your door</span>
        </div>
      </div>

      <!-- ABOVE-THE-FOLD INSTANT LEAD CAPTURE CARD -->
      <aside class="nb-card" aria-label="Request a Newport Beach House Call">
        <div class="nb-card__head">
          <span class="nb-card__badge">Fastest Response</span>
          <h2>Request a Newport Beach House Call</h2>
          <p>Call <a href={SITE.phoneHref}><strong>{SITE.phone}</strong></a> for immediate dispatch, or request a callback below.</p>
        </div>

        <form
          class="nb-card__form"
          id="nb-lead-form"
          action={action}
          method="POST"
          data-has-endpoint={action ? 'true' : 'false'}
        >
          <input type="hidden" name="_subject" value="Newport Beach House Call Request — Paid Landing Page" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="landing_page" value="Newport Beach House Calls (/newport-beach-ca/)" />
          <input type="hidden" name="_next" value={`${SITE.url}/contact-us/?sent=1`} />
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

          <div class="field">
            <label for="nb-name">Your Name *</label>
            <input id="nb-name" name="name" required autocomplete="name" placeholder="First & Last Name" />
          </div>

          <div class="nb-card__row">
            <div class="field">
              <label for="nb-phone">Phone Number *</label>
              <input id="nb-phone" name="phone" type="tel" required autocomplete="tel" placeholder="(949) 555-0123" />
            </div>
            <div class="field">
              <label for="nb-area">Newport Beach Area</label>
              <select id="nb-area" name="neighborhood">
                <option value="Newport Beach">Select Neighborhood</option>
                {neighborhoods.map((n) => <option value={n}>{n}</option>)}
                <option value="Newport Beach Hotel / Resort">Hotel / Resort</option>
                <option value="Other Newport Beach">Other Newport Beach</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="nb-urgency">When do you need to be seen?</label>
            <select id="nb-urgency" name="timeframe">
              <option value="Today (Same-Day House Call)">Today (Same-Day House Call)</option>
              <option value="Tomorrow (Next-Day House Call)">Tomorrow (Next-Day House Call)</option>
              <option value="This Week">This Week</option>
              <option value="Interested in Concierge Membership">Interested in Concierge Membership</option>
            </select>
          </div>

          <div class="field">
            <label for="nb-msg">How can Dr. Khaneki help? (Optional)</label>
            <textarea id="nb-msg" name="message" rows="2" placeholder="Brief reason for visit (please omit sensitive details)"></textarea>
          </div>

          <button type="submit" class="btn btn--gold btn--block btn--lg">
            Request House Call <Icon name="arrow" />
          </button>

          <p class="nb-card__note">
            Open Mon–Sun, {SITE.hours.label}. For life-threatening emergencies, call 911.
          </p>
        </form>
      </aside>
    </div>
  </section>

  <!-- AUTHORITY STRIP -->
  <section class="creds" aria-label="Key house call benefits">
    <div class="container creds__grid">
      {credentials.map((c) => (
        <div class="cred reveal">
          <Icon name={c.icon} size={22} />
          <div>
            <strong>{c.big}</strong>
            <span>{c.small}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- WHAT WE TREAT AT YOUR NEWPORT BEACH HOME -->
  <section class="section" aria-labelledby="treat-title">
    <div class="container">
      <div class="center reveal">
        <p class="eyebrow">Comprehensive In-Home Medicine</p>
        <h2 id="treat-title">Medical Care Brought Directly to Your Newport Beach Residence</h2>
        <p class="lede">
          Whether you are recovering from an acute illness at home in Corona del Mar, caring for an aging parent in Eastbluff, or staying at a resort in Newport Coast, Dr. Khaneki brings the doctor’s office to you.
        </p>
      </div>

      <div class="grid grid-3 care-grid">
        {careCategories.map((cat, i) => (
          <div class="card care-card reveal" style={`transition-delay:${i * 80}ms`}>
            <span class="icon-badge"><Icon name={cat.icon} /></span>
            <h3>{cat.title}</h3>
            <p>{cat.text}</p>
            <ul class="care-list">
              {cat.items.map((item) => (
                <li>
                  <Icon name="check" size={16} />
                  <a href={item.href}>{item.label}</a>
                </li>
              ))}
            </ul>
            <a href={SITE.phoneHref} class="care-cta">
              Call {SITE.phone} to Schedule <Icon name="arrow" size={15} />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY NEWPORT BEACH RESIDENTS CHOOSE US VS URGENT CARE -->
  <section class="section section--ink" aria-labelledby="vs-title">
    <div class="container vs-grid">
      <div class="reveal">
        <p class="eyebrow" style="color:var(--gold-2)">Why Choose a House Call</p>
        <h2 id="vs-title">
          Skip the Urgent Care Wait on PCH. <span class="gold-text">Your Physician Comes to You.</span>
        </h2>
        <p>
          When you’re running a fever, dealing with severe congestion, or caring for an elderly loved one with limited mobility, the last thing you want is traffic on Pacific Coast Highway and an hour-long wait in a crowded clinic.
        </p>
        <p>
          With Orange County House Calls, you never sit in a waiting room or get rushed through a 7-minute appointment. You receive 45–60+ minutes of undivided attention from a board-certified Internal Medicine physician in the privacy and comfort of your own living room.
        </p>

        <div class="vs-actions">
          <a href={SITE.phoneHref} class="btn btn--gold btn--lg"><Icon name="phone" /> Call {SITE.phone}</a>
          <button type="button" class="btn btn--light btn--lg" data-open-appt><Icon name="calendar" /> Request Visit</button>
        </div>
      </div>

      <div class="compare compare--dark reveal" role="table" aria-label="Urgent Care vs Orange County House Calls">
        <div class="compare__row compare__row--head" role="row">
          <span role="columnheader">Typical Urgent Care</span>
          <span role="columnheader">Newport Beach House Call</span>
        </div>
        {compare.map(([bad, good]) => (
          <div class="compare__row" role="row">
            <span role="cell" class="compare__bad"><Icon name="x" size={15} /> {bad}</span>
            <span role="cell" class="compare__good"><Icon name="check" size={15} /> {good}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS IN 3 STEPS -->
  <section class="section section--sand" aria-labelledby="steps-title">
    <div class="container">
      <div class="center reveal">
        <p class="eyebrow">How It Works</p>
        <h2 id="steps-title">A Doctor at Your Newport Beach Door in 3 Simple Steps</h2>
        <p class="lede">Fast, discreet, and effortless — from your first phone call to follow-up care.</p>
      </div>

      <ol class="steps__list">
        {steps.map((s, i) => (
          <li class="step reveal" style={`transition-delay:${i * 90}ms`}>
            <span class="step__n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>

      <div class="center steps__cta reveal">
        <a href={SITE.phoneHref} class="btn btn--gold btn--lg"><Icon name="phone" /> Call {SITE.phone} to Book Now</a>
        <p class="micro">Or <button type="button" class="link-btn" data-open-appt>request your house call online</button> — open 7 days, {SITE.hours.label}.</p>
      </div>
    </div>
  </section>

  <!-- MEET DR. SINA KHANEKI + TRANSPARENT PRICING -->
  <section class="section" aria-labelledby="doc-title">
    <div class="container doc-price-grid">
      <div class="doc-card reveal">
        <div class="doc-card__media">
          <Image src={doc} alt="Dr. Sina Khaneki, MD, MPH — Newport Beach House Call Physician" width={360} height={480} class="doc-card__img" />
          <div class="doc-card__badge">
            <strong>{DOCTOR.name}</strong>
            <span>Board-Certified Internal Medicine</span>
          </div>
        </div>
        <div class="doc-card__body">
          <p class="eyebrow">Meet Your Physician</p>
          <h2 id="doc-title">Personally Treated by {DOCTOR.name}</h2>
          <p>
            Unlike on-demand apps that dispatch whoever is on shift, every Newport Beach patient is cared for personally by <strong>Dr. Sina Khaneki, MD, MPH</strong>.
          </p>
          <p>
            Dr. Khaneki completed his Internal Medicine Residency at Hurley Medical Center / Michigan State University (serving as Ambulatory Clinic Chief Resident), earned his Master of Public Health at Indiana University, and is completing a Fellowship in Integrative and Functional Medicine at the <strong>University of California, Irvine (UCI)</strong>.
          </p>
          <ul class="ticks">
            <li><Icon name="check" size={18} /> Board-Certified Internal Medicine Physician</li>
            <li><Icon name="check" size={18} /> UCI Integrative &amp; Functional Medicine Fellow</li>
            <li><Icon name="check" size={18} /> 14+ Peer-Reviewed Medical Publications</li>
            <li><Icon name="check" size={18} /> Member: ACP, Obesity Medicine Association</li>
          </ul>
          <a href="/about/" class="btn btn--ghost btn--sm">Read Full Physician Bio <Icon name="arrow" /></a>
        </div>
      </div>

      <!-- TRANSPARENT PRICING BOX -->
      <div class="price reveal" id="pricing">
        <span class="price__tag">Transparent Pricing</span>
        <h3 class="price__name">One-Time Visit or Ongoing Concierge Care</h3>
        <p class="price__sub">No surprise hospital bills or hidden fees. Choose what fits your needs:</p>

        <div class="price__amt">
          <div>
            <strong>$500</strong>
            <span>/house call</span>
            <small>Single visit · No membership needed</small>
          </div>
          <div class="price__or">or</div>
          <div>
            <strong>$500</strong>
            <span>/month</span>
            <small>{MEMBERSHIP.monthlyNote}</small>
          </div>
        </div>

        <p class="price__inc">Every Newport Beach House Call Includes:</p>
        <ul class="price__list">
          <li><Icon name="check" size={18} /> Unrushed in-home examination by Dr. Khaneki (MD, MPH)</li>
          <li><Icon name="check" size={18} /> Personalized treatment plan &amp; clinical care</li>
          <li><Icon name="check" size={18} /> Same-day prescriptions sent to your local pharmacy</li>
          <li><Icon name="check" size={18} /> Direct physician follow-up after your visit</li>
        </ul>

        <a href={SITE.phoneHref} class="btn btn--gold btn--block btn--lg">
          <Icon name="phone" /> Call {SITE.phone}
        </a>
        <button type="button" class="btn btn--light btn--block" data-open-appt style="margin-top:.65rem">
          <Icon name="calendar" /> Request Appointment Online
        </button>
        <p class="price__disc">{MEMBERSHIP.disclaimer}</p>
      </div>
    </div>
  </section>

  <!-- FEATURED PATIENT STORY + GOOGLE REVIEWS -->
  <section class="section section--sand" aria-labelledby="reviews-title">
    <div class="container">
      <div class="center reveal">
        <p class="eyebrow">Patient Reviews</p>
        <h2 id="reviews-title">Why Coastal Orange County Families Trust Dr. Khaneki</h2>
        <p class="lede">Real 5-star experiences from patients and families who needed attentive, in-home medical care.</p>
      </div>

      {featuredStory && (
        <blockquote class="nb-quote reveal">
          <p>“{featuredStory.text}”</p>
          <footer>
            <span class="nb-stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={15} />)}</span>
            <strong>— {featuredStory.name}, Verified Google Review</strong>
          </footer>
        </blockquote>
      )}

      <div class="grid grid-3" style="margin-top:2rem">
        {reviews.map((r) => (
          <div class="reveal">
            <ReviewCard review={r} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- NEWPORT BEACH NEIGHBORHOODS & MAP -->
  <section class="section" aria-labelledby="areas-title">
    <div class="container local-grid">
      <div class="reveal">
        <p class="eyebrow">Service Coverage</p>
        <h2 id="areas-title">Serving Every Neighborhood in Newport Beach, CA</h2>
        <p>
          From bayfront homes on Balboa Island and Lido Isle to hillside estates in Newport Coast and Pelican Hill, we provide prompt, discreet house calls across all of Newport Beach (ZIP codes <strong>92657, 92658, 92659, 92660, 92661, 92662, and 92663</strong>).
        </p>

        <ul class="nb-hoods" aria-label="Newport Beach neighborhoods served">
          {neighborhoods.map((n) => (
            <li><Icon name="pin" size={14} /> {n}</li>
          ))}
        </ul>

        <div class="nb-office">
          <Image src={consult} alt="In-home doctor consultation in Newport Beach" width={120} height={90} class="nb-office__thumb" />
          <div>
            <strong>Need to be seen today in Newport Beach?</strong>
            <p>Call <a href={SITE.phoneHref}>{SITE.phone}</a> to confirm our next available arrival window.</p>
          </div>
        </div>
      </div>

      <iframe
        class="local-map reveal"
        title="Map of Newport Beach, California House Call Service Area"
        src={mapSrc}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--sand" aria-labelledby="faq-title">
    <div class="narrow">
      <div class="center reveal">
        <p class="eyebrow">Newport Beach House Call FAQs</p>
        <h2 id="faq-title">Common Questions Before Booking</h2>
      </div>
      <div class="reveal" style="margin-top:2rem">
        <FAQList faqs={nbFaqs} />
      </div>
      <div class="center reveal" style="margin-top:2.25rem">
        <p style="margin-bottom:.85rem; font-weight:600; color:var(--ink)">Still have a question? Speak directly with our team:</p>
        <a href={SITE.phoneHref} class="btn btn--gold btn--lg"><Icon name="phone" /> Call {SITE.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const nbForm = document.getElementById('nb-lead-form') as HTMLFormElement | null;
  nbForm?.addEventListener('submit', (e) => {
    if (nbForm.dataset.hasEndpoint !== 'true') {
      e.preventDefault();
      if (confirm('Online requests are being set up. Would you like to call us now at (949) 741-0512 for immediate Newport Beach house call scheduling?')) {
        window.location.href = 'tel:+19497410512';
      }
    }
  });
</script>

