---
import { Image } from 'astro:assets';
import logo from '../assets/logo-clean.png';
import Icon from './Icon.astro';
import { NAV, SITE } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<div class="topbar">
  <div class="container topbar__inner">
    <a href={SITE.directionsUrl} target="_blank" rel="noopener" class="topbar__item">
      <Icon name="pin" size={15} /> {SITE.address.street}, {SITE.address.city}, {SITE.address.region} {SITE.address.postal}
    </a>
    <span class="topbar__item hide-sm"><Icon name="clock" size={15} /> Open 7 days · {SITE.hours.label}</span>
    <a href={SITE.phoneHref} class="topbar__item topbar__phone"><Icon name="phone" size={15} /> {SITE.phone}</a>
  </div>
</div>

<header class="site-header" id="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label={`${SITE.name} — Home`}>
      <Image src={logo} alt={`${SITE.name} logo`} width={170} height={91} loading="eager" fetchpriority="high" />
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {NAV.map((item) => (
          <li class={`nav__item ${item.children ? 'has-dd' : ''}`}>
            <a href={item.href} class={`nav__link ${isActive(item.href) ? 'is-active' : ''}`} aria-current={path === item.href ? 'page' : undefined}>
              {item.label}
              {item.children && <Icon name="chevron" size={14} class="nav__chev" />}
            </a>
            {item.children && (
              <div class="dd">
                <ul class={`dd__list ${item.children.length > 9 ? 'dd__list--cols' : ''}`}>
                  {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-cta">
      <button type="button" class="btn btn--gold btn--sm" data-open-appt>
        <Icon name="calendar" /> <span>Request Appointment</span>
      </button>
      <button type="button" class="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav" id="burger">
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>

<!-- Mobile navigation drawer -->
<div class="mnav" id="mobile-nav" hidden>
  <div class="mnav__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="mnav__head">
      <Image src={logo} alt="" width={130} height={70} />
      <button type="button" class="burger" aria-label="Close menu" id="mnav-close"><Icon name="x" /></button>
    </div>
    <ul class="mnav__list">
      {NAV.map((item) => (
        <li>
          {item.children ? (
            <details>
              <summary>{item.label} <Icon name="chevron" size={16} /></summary>
              <ul>{item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
            </details>
          ) : (
            <a href={item.href} class={isActive(item.href) ? 'is-active' : ''}>{item.label}</a>
          )}
        </li>
      ))}
    </ul>
    <div class="mnav__foot">
      <a href={SITE.phoneHref} class="btn btn--gold btn--block"><Icon name="phone" /> Call {SITE.phone}</a>
      <button type="button" class="btn btn--ghost btn--block" data-open-appt>Request Appointment</button>
    </div>
  </div>
</div>

<style>
  .topbar { background: #000; color: #c9c9c9; font-size: .82rem; border-bottom: 1px solid rgba(214, 184, 120, .18); }
  .topbar__inner { display: flex; gap: 1.5rem; justify-content: space-between; align-items: center; min-height: 40px; }
  .topbar__item { display: inline-flex; align-items: center; gap: .45rem; color: inherit; text-decoration: none; }
  .topbar__item :global(svg) { color: var(--gold-2); }
  .topbar a:hover { color: var(--gold-2); }
  .topbar__phone { font-weight: 700; color: #fff; margin-left: auto; }
  @media (max-width: 760px) { .hide-sm { display: none; } .topbar__inner { font-size: .76rem; gap: .75rem; } }
  @media (max-width: 520px) { .topbar__inner > a:first-child { display: none; } .topbar__phone { margin: 0 auto; } }

  .site-header {
    position: sticky; top: 0; z-index: 50; background: rgba(5, 5, 5, .96);
    backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid rgba(214, 184, 120, .22); transition: box-shadow .3s var(--ease);
  }
  .site-header.is-scrolled { box-shadow: 0 10px 30px -12px rgba(0, 0, 0, .6); }
  .site-header__inner { display: flex; align-items: center; gap: 1.5rem; min-height: var(--header-h); }
  .brand { flex: none; display: block; }
  .brand :global(img) { width: 150px; height: auto; transition: width .3s var(--ease); }
  .site-header.is-scrolled .brand :global(img) { width: 128px; }

  .nav { flex: 1; display: flex; justify-content: center; }
  .nav__list { display: flex; align-items: center; gap: .1rem; list-style: none; margin: 0; padding: 0; }
  .nav__item { position: relative; }
  .nav__link {
    display: inline-flex; align-items: center; gap: .25rem; padding: .6rem .7rem; border-radius: 10px;
    font-size: .88rem; font-weight: 600; color: #fff; text-decoration: none; white-space: nowrap;
    transition: color .2s var(--ease), background-color .2s var(--ease);
  }
  .nav__link:hover, .nav__link.is-active, .has-dd:hover > .nav__link, .has-dd:focus-within > .nav__link { color: var(--gold-2); background: rgba(214, 184, 120, .12); }
  .nav__chev { transition: transform .25s var(--ease); }
  .dd {
    position: absolute; top: 100%; left: 50%; transform: translate(-50%, 8px); padding-top: .6rem;
    opacity: 0; visibility: hidden; transition: opacity .25s var(--ease), transform .25s var(--ease), visibility .25s;
  }
  .has-dd:hover .dd, .has-dd:focus-within .dd { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
  .has-dd:hover .nav__chev { transform: rotate(180deg); }
  .dd__list {
    list-style: none; margin: 0; padding: .75rem; min-width: 260px; background: #0b0b0b; border: 1px solid rgba(214, 184, 120, .25);
    border-radius: 16px; box-shadow: 0 30px 60px -20px rgba(0, 0, 0, .7);
  }
  .dd__list--cols { columns: 2; column-gap: .5rem; min-width: 520px; }
  .dd__list li { break-inside: avoid; }
  .dd__list a { display: block; padding: .55rem .8rem; border-radius: 10px; font-size: .88rem; color: #e8e8e8; text-decoration: none; }
  .dd__list a:hover { background: rgba(214, 184, 120, .12); color: var(--gold-2); }

  .header-cta { display: flex; align-items: center; gap: .5rem; flex: none; }
  .burger { display: none; width: 46px; height: 46px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, .22); background: transparent; color: #fff; cursor: pointer; place-items: center; }
  .mnav__head .burger { border-color: var(--line); color: var(--ink); }

  @media (max-width: 1180px) {
    .nav { display: none; }
    .burger { display: grid; }
    .site-header__inner { justify-content: space-between; }
  }
  @media (max-width: 560px) {
    .header-cta .btn span { display: none; }
    .header-cta .btn { padding: .7rem; width: 46px; height: 46px; }
    .brand :global(img) { width: 120px; }
    .site-header.is-scrolled .brand :global(img) { width: 110px; }
    :root { --header-h: 72px; }
  }

  .mnav { position: fixed; inset: 0; z-index: 100; background: rgba(14, 27, 42, .55); backdrop-filter: blur(4px); }
  .mnav[hidden] { display: none; }
  .mnav__panel {
    position: absolute; right: 0; top: 0; bottom: 0; width: min(420px, 100%); background: var(--ivory);
    display: flex; flex-direction: column; animation: slideIn .35s var(--ease);
  }
  @keyframes slideIn { from { transform: translateX(100%); } }
  .mnav__head { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.25rem; border-bottom: 1px solid var(--line); }
  .mnav__head .burger { display: grid; }
  .mnav__list { list-style: none; margin: 0; padding: .5rem 1.25rem; overflow-y: auto; flex: 1; }
  .mnav__list > li { border-bottom: 1px solid var(--line); }
  .mnav__list a, .mnav__list summary {
    display: flex; justify-content: space-between; align-items: center; padding: 1rem .25rem; font-weight: 700;
    color: var(--ink); text-decoration: none; cursor: pointer; list-style: none;
  }
  .mnav__list summary::-webkit-details-marker { display: none; }
  .mnav__list details[open] summary :global(svg) { transform: rotate(180deg); }
  .mnav__list details ul { list-style: none; margin: 0 0 .75rem; padding: 0 0 0 .75rem; border-left: 2px solid var(--gold-3); }
  .mnav__list details a { font-weight: 500; padding: .55rem .5rem; font-size: .95rem; }
  .mnav__list a.is-active { color: var(--gold); }
  .mnav__foot { padding: 1.25rem; display: grid; gap: .6rem; border-top: 1px solid var(--line); }
</style>

<script>
  const header = document.getElementById('site-header');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 10);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const drawer = document.getElementById('mobile-nav') as HTMLElement | null;
  const burger = document.getElementById('burger');
  const close = document.getElementById('mnav-close');
  const toggle = (open: boolean) => {
    if (!drawer) return;
    drawer.hidden = !open;
    burger?.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };
  burger?.addEventListener('click', () => toggle(true));
  close?.addEventListener('click', () => toggle(false));
  drawer?.addEventListener('click', (e) => { if (e.target === drawer) toggle(false); });
  drawer?.querySelectorAll('a, [data-open-appt]').forEach((a) => a.addEventListener('click', () => toggle(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') toggle(false); });
</script>
