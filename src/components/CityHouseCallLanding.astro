---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import ReviewCard from './ReviewCard.astro';
import FAQList from './FAQList.astro';
import { Image } from 'astro:assets';
import hero from '../assets/s1-new-2.jpg';
import consult from '../assets/s1.jpg';
import doc from '../assets/dr-khaneki-2607.jpg';
import { SITE, DOCTOR, MEMBERSHIP } from '../data/site';
import { REVIEWS } from '../data/reviews';
import { CITIES, type CityHouseCallData } from '../data/cities';
import { breadcrumb, faqPage, medicalWebPage, serviceSchema } from '../lib/schema';

interface Props {
  city: CityHouseCallData;
}

const { city } = Astro.props;
const { path, name } = city;

const title = `House Call Doctor in ${name}, CA | Same-Day In-Home Physician | ${SITE.phone}`;
const description = `Need a house call doctor in ${name}, CA? Board-certified Internal Medicine physician Dr. Sina Khaneki, MD, MPH brings private, unrushed medical care directly to your ${name} home, office, or senior residence — 7 days a week. Call ${SITE.phone}.`;

const crumbs = [
  { name: 'Home', path: '/' },
  { name: `${name} House Calls`, path },
];

const action = SITE.formEmail ? `https://formsubmit.co/${SITE.formEmail}` : '';

const credentials = [
  { icon: 'shield', big: 'Board-Certified', small: 'Internal Medicine (MD, MPH)' },
  { icon: 'clock', big: 'Same-Day / Next-Day', small: `Open 7 Days · ${SITE.hours.label}` },
  {
    icon: 'home',
    big: 'At Your Doorstep',
    small: city.hasResortsOrHotels ? 'Home, Hotel, Office or Senior Living' : 'Home, Estate, Office or Senior Living',
  },
  { icon: 'star', big: '5.0 ★ Rated', small: city.regionLabel },
];

const toolkit = [
  'Complete vitals & unhurried physical exam',
  'Rapid point-of-care flu, strep & respiratory evaluation',
  'Minor wound, rash, burn & sprain care',
  'Medication review & chronic disease management',
  `Same-day e-prescriptions to ${name} pharmacies`,
  'Direct phone follow-up with Dr. Khaneki',
];

const careCategories = [
  {
    icon: 'activity',
    title: 'Urgent & Sick House Calls',
    text: `Skip the crowded ${name} urgent care lobby. Get thorough in-home diagnosis and rapid symptom relief when you or a family member feel unwell.`,
    items: [
      { label: 'Cold, Flu & Respiratory Illness', href: '/aliso-viejo-ca/common-cold-and-flu-treatment/' },
      { label: 'Sinus, Ear & Strep Throat Infections', href: '/aliso-viejo-ca/sinus-infection-treatment/' },
      { label: 'Fever, Dehydration & Food Poisoning', href: '/aliso-viejo-ca/food-poisoning-treatment/' },
      { label: 'UTI, Migraines & Acute Pain', href: '/aliso-viejo-ca/urinary-tract-infection/' },
    ],
  },
  {
    icon: 'heart',
    title: 'Senior & Geriatric House Calls',
    text: `Compassionate, unhurried medical visits for older adults at home or in ${name} senior living communities — giving families complete peace of mind.`,
    items: [
      { label: 'Comprehensive Geriatric Care', href: '/aliso-viejo-ca/geriatric-medicine/' },
      { label: 'Post-Hospital & Fall Evaluations', href: '/aliso-viejo-ca/when-an-older-person-falls/' },
      { label: 'Chronic Disease & Medication Review', href: '/aliso-viejo-ca/chronic-disease-management/' },
      { label: 'Mobility-Friendly In-Home Exams', href: '/aliso-viejo-ca/physical-exams/' },
    ],
  },
  {
    icon: 'stethoscope',
    title: 'Concierge Primary Care & Wellness',
    text: 'Ongoing private physician access, executive-level preventive care, and medically supervised weight loss tailored to your schedule.',
    items: [
      { label: 'Premier Concierge Medicine', href: '/aliso-viejo-ca/concierge-medicine/' },
      { label: 'Physician-Guided Weight Loss', href: '/aliso-viejo-ca/weight-loss-treatment/' },
      { label: 'Preventive & Longevity Care', href: '/aliso-viejo-ca/preventive-medicine/' },
      { label: 'Minor Injuries & Auto Accidents', href: '/aliso-viejo-ca/personal-injury-auto-accident-care/' },
    ],
  },
];

const steps = [
  {
    n: '01',
    title: 'Call or Request Online',
    text: `Call us directly at ${SITE.phone} or submit the quick request form on this page. We confirm your symptoms, ${name} address or gate details, and preferred arrival window.`,
  },
  {
    n: '02',
    title: `Dr. Khaneki Arrives in ${name}`,
    text: `A board-certified Internal Medicine physician — never a rotating app contractor — arrives directly at your ${name} home, gated community, senior residence, or office.`,
  },
  {
    n: '03',
    title: 'Unrushed Care & Local Prescriptions',
    text: `Receive a 45–60+ minute exam, clear treatment plan, prescriptions sent immediately to ${city.pharmacyNote}, and direct physician follow-up.`,
  },
];

const compare = [
  [`Driving on ${city.urgentCareRoad} while sick`, `Stay resting comfortably in your ${name} home`],
  ['60–90+ minute urgent care lobby wait times', 'Same-day or next-day scheduled arrival window'],
  ['7-minute rushed visit with a mid-level provider', 'Extended 45–60+ minute visit with an MD, MPH Internist'],
  ['Exposure to contagious walk-in waiting rooms', '100% private, discreet care in your own living room'],
  ['Hard to reach anyone for follow-up questions', 'Direct follow-up access to Dr. Khaneki'],
];

const reviews = REVIEWS.filter((r) => r.source === 'Google').slice(0, 3);
const featuredStory = REVIEWS.find((r) => r.name === 'Omid H');

const cityFaqs = [
  {
    q: `How quickly can a house call doctor arrive in ${name}?`,
    a: `${city.driveNote}. We offer same-day and next-day house call appointments throughout ${name} 7 days a week from ${SITE.hours.label}. For the fastest dispatch, call <a href="${SITE.phoneHref}">${SITE.phone}</a>.`,
  },
  {
    q: `Do I need a concierge membership to book a one-time house call in ${name}?`,
    a: `No. You can book a single ${name} house call for a flat <strong>$500/visit</strong> with no membership required. If you want ongoing year-round direct physician access, house calls, telemedicine, and in-office care, our Premier Concierge Membership is $500/month (with a 1-year membership).`,
  },
  {
    q: `Which ${name} neighborhoods and gated communities do you serve?`,
    a: `Dr. Khaneki serves every neighborhood in ${name} (ZIP ${city.zipCodes.length > 1 ? 'codes' : 'code'} ${city.zipCodes.join(', ')}), including ${city.neighborhoods.slice(0, 8).join(', ')}, and surrounding enclaves. ${city.gatedOrAccessNote}`,
  },
  {
    q: 'Will I be seen by an actual board-certified MD during my house call?',
    a: 'Yes. Every house call is personally performed by <strong>Dr. Sina Khaneki, MD, MPH</strong>, a board-certified Internal Medicine physician and former Ambulatory Clinic Chief Resident — never an outsourced urgent care contractor.',
  },
  {
    q: `Can Dr. Khaneki send prescriptions to my pharmacy in ${name}?`,
    a: `Yes. Whenever medication is medically appropriate, Dr. Khaneki electronically sends prescriptions right away to ${city.pharmacyNote}.`,
  },
  {
    q: `Do you accept insurance for ${name} house calls?`,
    a: 'Our house call fee ($500/visit) and concierge membership are direct-pay and not billed to insurance, allowing us to provide extended, unhurried in-home visits without insurance restrictions. You may still use your insurance for outside lab work, imaging, prescriptions, and specialist referrals.',
  },
];

const placeSchema = {
  '@type': 'Service',
  name: `House Call Doctor & Concierge Medicine in ${name}, CA`,
  serviceType: 'In-Home Medical Care / Physician House Calls',
  provider: { '@id': `${SITE.url}/#clinic` },
  areaServed: {
    '@type': 'City',
    name: `${name}, CA`,
    sameAs: city.wikiUrl,
  },
  description,
  offers: {
    '@type': 'Offer',
    price: '500',
    priceCurrency: 'USD',
    description: `Single ${name} physician house call ($500/visit) or Premier Concierge Membership ($500/month).`,
  },
};

const cityPlaceNode = {
  '@type': 'City',
  name,
  containedInPlace: { '@type': 'AdministrativeArea', name: 'Orange County, California' },
  sameAs: city.wikiUrl,
};

const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(`${name}, CA`)}&output=embed`;
const otherCities = CITIES.filter((c) => c.slug !== city.slug);
---

<BaseLayout
  title={title}
  description={description}
  cityContext={{ name, lat: city.lat, lng: city.lng }}
  schema={[
    medicalWebPage({ path, title, description, about: `House Call Doctor in ${name}, CA` }),
    serviceSchema({ name: `House Call Doctor in ${name}`, path, description }),
    placeSchema,
    cityPlaceNode,
    breadcrumb(crumbs),
    faqPage(cityFaqs),
  ]}
>
  <!-- HIGH-CONVERTING CITY HOUSE CALL HERO -->
  <section class="hc-hero" aria-labelledby="hc-hero-title">
    <Image
      src={hero}
      alt={`Dr. Sina Khaneki, MD, MPH — ${name} House Call Physician`}
      class="hc-hero__bg"
      widths={[640, 1024, 1440, 1835]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hc-hero__overlay"></div>

    <div class="container hc-hero__grid">
      <div class="hc-hero__copy">
        <div class="hc-pill">
          <span class="hc-pill__dot" aria-hidden="true"></span>
          <span>{city.heroPill}</span>
        </div>

        <h1 id="hc-hero-title">
          Private <span class="gold-text">House Call Doctor</span> in {name}, CA
        </h1>

        <p class="hc-hero__lede">{city.heroLede}</p>

        <div class="hc-hero__ctas">
          <a href={SITE.phoneHref} class="btn btn--gold btn--lg">
            <Icon name="phone" /> Call Now: {SITE.phone}
          </a>
          <button type="button" class="btn btn--light btn--lg" data-open-appt>
            <Icon name="calendar" /> Book Online
          </button>
        </div>

        <ul class="hc-hero__trust">
          <li><Icon name="check" size={16} /> <strong>$500</strong> flat-rate single house call (no membership required)</li>
          <li><Icon name="check" size={16} /> Personally treated by a board-certified MD — never a call center</li>
          <li><Icon name="check" size={16} /> Same-day prescriptions sent to your local {name} pharmacy</li>
        </ul>

        <div class="hc-hero__proof">
          <span class="hc-stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={16} />)}</span>
          <span><strong>5.0 Rating on Google</strong> · Discreet, unhurried care at your door</span>
        </div>
      </div>

      <!-- ABOVE-THE-FOLD CITY LEAD CAPTURE CARD -->
      <aside class="hc-card" aria-label={`Request a ${name} House Call`}>
        <div class="hc-card__head">
          <span class="hc-card__badge">Fastest Dispatch</span>
          <h2>Request a {name} House Call</h2>
          <p>Call <a href={SITE.phoneHref}><strong>{SITE.phone}</strong></a> for immediate scheduling, or request a callback below.</p>
        </div>

        <form
          class="hc-card__form"
          id="city-lead-form"
          action={action}
          method="POST"
          data-has-endpoint={action ? 'true' : 'false'}
          data-city={name}
        >
          <input type="hidden" name="_subject" value={`${name} House Call Request — Landing Page`} />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="city" value={`${name}, CA`} />
          <input type="hidden" name="landing_page" value={path} />
          <input type="hidden" name="_next" value={`${SITE.url}/contact-us/?sent=1`} />
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

          <div class="field">
            <label for="hc-name">Your Name *</label>
            <input id="hc-name" name="name" required autocomplete="name" placeholder="First & Last Name" />
          </div>

          <div class="hc-card__row">
            <div class="field">
              <label for="hc-phone">Phone Number *</label>
              <input id="hc-phone" name="phone" type="tel" required autocomplete="tel" placeholder="(949) 555-0123" />
            </div>
            <div class="field">
              <label for="hc-area">{name} Area</label>
              <select id="hc-area" name="neighborhood">
                <option value={name}>Select Neighborhood</option>
                {city.neighborhoods.map((n) => <option value={`${n} (${name})`}>{n}</option>)}
                {city.hasResortsOrHotels && <option value={`${name} Hotel / Resort`}>Hotel / Resort</option>}
                <option value={`Senior Living (${name})`}>Senior Living Community</option>
                <option value={`Other ${name}`}>Other {name}</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="hc-urgency">When do you need to be seen?</label>
            <select id="hc-urgency" name="timeframe">
              <option value="Today (Same-Day House Call)">Today (Same-Day House Call)</option>
              <option value="Tomorrow (Next-Day House Call)">Tomorrow (Next-Day House Call)</option>
              <option value="This Week">This Week</option>
              <option value="Interested in Concierge Membership">Interested in Concierge Membership</option>
            </select>
          </div>

          <div class="field">
            <label for="hc-msg">How can Dr. Khaneki help? (Optional)</label>
            <textarea id="hc-msg" name="message" rows="2" placeholder="Brief reason for visit (please omit sensitive details)"></textarea>
          </div>

          <button type="submit" class="btn btn--gold btn--block btn--lg">
            Request {name} House Call <Icon name="arrow" />
          </button>

          <p class="hc-card__note">
            Open Mon–Sun, {SITE.hours.label}. For life-threatening emergencies, call 911.
          </p>
        </form>
      </aside>
    </div>
  </section>

  <!-- AUTHORITY STRIP -->
  <section class="creds" aria-label="Key house call benefits">
    <div class="container creds__grid">
      {credentials.map((c) => (
        <div class="cred reveal">
          <Icon name={c.icon} size={22} />
          <div>
            <strong>{c.big}</strong>
            <span>{c.small}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- WHAT WE TREAT AT YOUR HOME + IN-HOME TOOLKIT -->
  <section class="section" aria-labelledby="treat-title">
    <div class="container">
      <div class="center reveal">
        <p class="eyebrow">In-Home Medical Care in {name}</p>
        <h2 id="treat-title">Comprehensive Doctor Visits at Your {name} Residence</h2>
        <p class="lede">{city.localIntro}</p>
      </div>

      <div class="grid grid-3 care-grid">
        {careCategories.map((cat, i) => (
          <div class="card care-card reveal" style={`transition-delay:${i * 80}ms`}>
            <span class="icon-badge"><Icon name={cat.icon} /></span>
            <h3>{cat.title}</h3>
            <p>{cat.text}</p>
            <ul class="care-list">
              {cat.items.map((item) => (
                <li>
                  <Icon name="check" size={16} />
                  <a href={item.href}>{item.label}</a>
                </li>
              ))}
            </ul>
            <a href={SITE.phoneHref} class="care-cta">
              Call {SITE.phone} to Schedule <Icon name="arrow" size={15} />
            </a>
          </div>
        ))}
      </div>

      <!-- WHAT DR. KHANEKI BRINGS TO YOUR HOME -->
      <div class="toolkit reveal">
        <div>
          <p class="eyebrow">Everything Needed for Thorough Care</p>
          <h3>What Happens During Your {name} House Call</h3>
          <p class="toolkit__sub">
            Dr. Khaneki arrives directly at your residence equipped to evaluate, diagnose, and treat acute and chronic conditions without you stepping foot outside.
          </p>
        </div>
        <ul class="toolkit__list">
          {toolkit.map((item) => (
            <li><Icon name="check" size={17} /> {item}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- WHY RESIDENTS CHOOSE HOUSE CALLS OVER URGENT CARE -->
  <section class="section section--ink" aria-labelledby="vs-title">
    <div class="container vs-grid">
      <div class="reveal">
        <p class="eyebrow" style="color:var(--gold-2)">Why {name} Patients Switch</p>
        <h2 id="vs-title">
          Skip Urgent Care Waits. <span class="gold-text">Your Doctor Comes to You in {name}.</span>
        </h2>
        <p>{city.urgentCarePainPoint}</p>
        <p>
          With Orange County House Calls, you never sit in a crowded lobby or get rushed through a 7-minute visit. You receive 45–60+ minutes of unhurried, one-on-one care from a board-certified Internal Medicine physician in the privacy and comfort of your own {name} home.
        </p>

        <div class="vs-actions">
          <a href={SITE.phoneHref} class="btn btn--gold btn--lg"><Icon name="phone" /> Call {SITE.phone}</a>
          <button type="button" class="btn btn--light btn--lg" data-open-appt><Icon name="calendar" /> Request Visit</button>
        </div>
      </div>

      <div class="compare reveal" role="table" aria-label={`Urgent Care vs ${name} House Call`}>
        <div class="compare__row compare__row--head" role="row">
          <span role="columnheader">Typical Walk-In Clinic</span>
          <span role="columnheader">{name} House Call</span>
        </div>
        {compare.map(([bad, good]) => (
          <div class="compare__row" role="row">
            <span role="cell" class="compare__bad"><Icon name="x" size={15} /> {bad}</span>
            <span role="cell" class="compare__good"><Icon name="check" size={15} /> {good}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS IN 3 STEPS -->
  <section class="section section--sand" aria-labelledby="steps-title">
    <div class="container">
      <div class="center reveal">
        <p class="eyebrow">How It Works</p>
        <h2 id="steps-title">A Physician at Your {name} Door in 3 Simple Steps</h2>
        <p class="lede">{city.driveNote} — fast, discreet, and effortless from your first call to follow-up.</p>
      </div>

      <ol class="steps__list">
        {steps.map((s, i) => (
          <li class="step reveal" style={`transition-delay:${i * 90}ms`}>
            <span class="step__n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>

      <div class="center steps__cta reveal">
        <a href={SITE.phoneHref} class="btn btn--gold btn--lg"><Icon name="phone" /> Call {SITE.phone} to Book Now</a>
        <p class="micro">Or <button type="button" class="link-btn" data-open-appt>request your {name} house call online</button> — open 7 days, {SITE.hours.label}.</p>
      </div>
    </div>
  </section>

  <!-- MEET DR. SINA KHANEKI + TRANSPARENT PRICING -->
  <section class="section" aria-labelledby="doc-title">
    <div class="container doc-price-grid">
      <div class="doc-card reveal">
        <div class="doc-card__media">
          <Image src={doc} alt={`Dr. Sina Khaneki, MD, MPH — ${name} House Call Physician`} width={360} height={480} class="doc-card__img" />
          <div class="doc-card__badge">
            <strong>{DOCTOR.name}</strong>
            <span>Board-Certified Internal Medicine</span>
          </div>
        </div>
        <div class="doc-card__body">
          <p class="eyebrow">Meet Your Physician</p>
          <h2 id="doc-title">Personally Treated by {DOCTOR.name}</h2>
          <p>
            Unlike on-demand apps that send whoever is on shift, every {name} house call is performed personally by <strong>Dr. Sina Khaneki, MD, MPH</strong>.
          </p>
          <p>
            Dr. Khaneki completed his Internal Medicine Residency at Hurley Medical Center / Michigan State University (serving as Ambulatory Clinic Chief Resident), earned his Master of Public Health at Indiana University, and is completing a Fellowship in Integrative and Functional Medicine at the <strong>University of California, Irvine (UCI)</strong>.
          </p>
          <ul class="ticks">
            <li><Icon name="check" size={18} /> Board-Certified Internal Medicine Physician</li>
            <li><Icon name="check" size={18} /> UCI Integrative &amp; Functional Medicine Fellow</li>
            <li><Icon name="check" size={18} /> 14+ Peer-Reviewed Medical Publications</li>
            <li><Icon name="check" size={18} /> Member: ACP, Obesity Medicine Association</li>
          </ul>
          <a href="/about/" class="btn btn--ghost btn--sm">Read Full Physician Bio <Icon name="arrow" /></a>
        </div>
      </div>

      <!-- TRANSPARENT PRICING BOX -->
      <div class="price reveal" id="pricing">
        <span class="price__tag">Transparent Pricing</span>
        <h3 class="price__name">One-Time House Call or Concierge Membership</h3>
        <p class="price__sub">No surprise urgent care bills or hidden fees. Choose what fits your needs:</p>

        <div class="price__amt">
          <div>
            <strong>$500</strong>
            <span>/house call</span>
            <small>Single visit · No membership needed</small>
          </div>
          <div class="price__or">or</div>
          <div>
            <strong>$500</strong>
            <span>/month</span>
            <small>{MEMBERSHIP.monthlyNote}</small>
          </div>
        </div>

        <p class="price__inc">Every {name} House Call Includes:</p>
        <ul class="price__list">
          <li><Icon name="check" size={18} /> Unrushed in-home examination by Dr. Khaneki (MD, MPH)</li>
          <li><Icon name="check" size={18} /> Personalized diagnosis &amp; clinical treatment plan</li>
          <li><Icon name="check" size={18} /> Same-day e-prescriptions sent to your local pharmacy</li>
          <li><Icon name="check" size={18} /> Direct physician follow-up after your visit</li>
        </ul>

        <a href={SITE.phoneHref} class="btn btn--gold btn--block btn--lg">
          <Icon name="phone" /> Call {SITE.phone}
        </a>
        <button type="button" class="btn btn--light btn--block" data-open-appt style="margin-top:.65rem">
          <Icon name="calendar" /> Request Appointment Online
        </button>
        <p class="price__disc">{MEMBERSHIP.disclaimer}</p>
      </div>
    </div>
  </section>

  <!-- FEATURED PATIENT STORY + GOOGLE REVIEWS -->
  <section class="section section--sand" aria-labelledby="reviews-title">
    <div class="container">
      <div class="center reveal">
        <p class="eyebrow">Patient Reviews</p>
        <h2 id="reviews-title">Why Orange County Families Trust Dr. Khaneki</h2>
        <p class="lede">Real 5-star experiences from patients and families who wanted attentive medical care at home.</p>
      </div>

      {featuredStory && (
        <blockquote class="hc-quote reveal">
          <p>“{featuredStory.text}”</p>
          <footer>
            <span class="hc-stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={15} />)}</span>
            <strong>— {featuredStory.name}, Verified Google Review</strong>
          </footer>
        </blockquote>
      )}

      <div class="grid grid-3" style="margin-top:2rem">
        {reviews.map((r) => (
          <div class="reveal">
            <ReviewCard review={r} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- NEIGHBORHOODS & MAP -->
  <section class="section" aria-labelledby="areas-title">
    <div class="container local-grid">
      <div class="reveal">
        <p class="eyebrow">{name} Service Area</p>
        <h2 id="areas-title">Serving Every Neighborhood in {name}, CA</h2>
        <p>
          {city.gatedOrAccessNote} We provide prompt, discreet house calls across all of {name} (ZIP {city.zipCodes.length > 1 ? 'codes' : 'code'} <strong>{city.zipCodes.join(', ')}</strong>).
        </p>

        <ul class="hc-hoods" aria-label={`${name} neighborhoods served`}>
          {city.neighborhoods.map((n) => (
            <li><Icon name="pin" size={14} /> {n}</li>
          ))}
        </ul>

        <div class="hc-office">
          <Image src={consult} alt={`In-home doctor consultation in ${name}, CA`} width={120} height={90} class="hc-office__thumb" />
          <div>
            <strong>Need a house call in {name} today?</strong>
            <p>Call <a href={SITE.phoneHref}>{SITE.phone}</a> to confirm our next available arrival window.</p>
          </div>
        </div>
      </div>

      <iframe
        class="local-map reveal"
        title={`Map of ${name}, California House Call Service Area`}
        src={mapSrc}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </section>

  <!-- OPTIONAL EXTRA CONTENT (e.g. Aliso Viejo full service directory) -->
  <slot />

  <!-- CITY FAQs -->
  <section class="section section--sand" aria-labelledby="faq-title">
    <div class="narrow">
      <div class="center reveal">
