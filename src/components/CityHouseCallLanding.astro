<script>
  const cityForm = document.getElementById('city-lead-form') as HTMLFormElement | null;
  cityForm?.addEventListener('submit', (e) => {
    if (cityForm.dataset.hasEndpoint !== 'true') {
      e.preventDefault();
      const cityName = cityForm.dataset.city || 'Orange County';
      if (confirm(`Online requests are being set up. Would you like to call us now at (949) 741-0512 for immediate ${cityName} house call scheduling?`)) {
