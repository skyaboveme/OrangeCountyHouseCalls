---
import Icon from './Icon.astro';
import type { Review } from '../data/reviews';
interface Props { review: Review }
const { review } = Astro.props;
const initials = review.name.split(' ').map((n) => n[0]).slice(0, 2).join('').toUpperCase();
---
<figure class="review">
  <div class="review__stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={16} />)}</div>
  <blockquote class="review__text">“{review.text}”</blockquote>
  <figcaption class="review__by">
    <span class="review__avatar" aria-hidden="true">{initials}</span>
    <span><strong>{review.name}</strong><small>{review.source === 'Google' ? 'Posted on Google' : 'Patient testimonial'}</small></span>
  </figcaption>
</figure>
<style>
  .review { margin: 0; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 1.75rem; display: flex; flex-direction: column; gap: 1rem; height: 100%; box-shadow: var(--shadow-sm); }
  .review__stars { display: flex; gap: 2px; color: var(--gold); }
  .review__text { margin: 0; color: #36414e; font-size: .98rem; line-height: 1.7; flex: 1; }
  .review__by { display: flex; align-items: center; gap: .8rem; }
  .review__by strong { display: block; color: var(--ink); font-size: .95rem; }
  .review__by small { color: var(--muted); font-size: .8rem; }
  .review__avatar { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; background: var(--gold-grad); color: var(--ink); font-weight: 800; font-size: .85rem; flex: none; }
</style>
