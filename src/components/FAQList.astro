---
interface Props { faqs: { q: string; a: string }[]; openFirst?: boolean }
const { faqs, openFirst = true } = Astro.props;
---
<div class="faq">
  {faqs.map((f, i) => (
    <details open={openFirst && i === 0}>
      <summary>{f.q}</summary>
      <div class="faq-a"><p set:html={f.a} /></div>
    </details>
  ))}
</div>
